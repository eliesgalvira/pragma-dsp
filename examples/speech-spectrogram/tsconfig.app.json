{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "incremental": true,
    "composite": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],

    "paths": {
      "pragma-dsp": ["../../src/index.ts"],
      "pragma-dsp/analysis": ["../../src/analysis/index.ts"],
      "pragma-dsp/xform/stft": ["../../src/xform/stft.ts"],
      "pragma-dsp/xform/fourier": ["../../src/xform/fourier.ts"],
      "pragma-dsp/xform/fourier-fluent": ["../../src/xform/fourier-fluent.ts"],
      "pragma-dsp/fluent": ["../../src/fluent/index.ts"],
      "pragma-dsp/math/complex": ["../../src/math/index.ts"],
      "pragma-dsp/core": ["../../src/core/index.ts"]
    },

    /* Linting */
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src",
    "../../src/analysis/**/*.ts",
    "../../src/core/**/*.ts",
    "../../src/fluent/**/*.ts",
    "../../src/math/**/*.ts",
    "../../src/xform/**/*.ts"
  ]
}
