{
  "name": "pragma-dsp",
  "version": "0.1.0-alpha.3",
  "description": "Useful DSP primitives for TypeScript.",
  "keywords": [
    "dsp",
    "fft",
    "stft",
    "spectrogram",
    "audio",
    "signal-processing",
    "typescript"
  ],
  "homepage": "https://github.com/eliesgalvira/pragma-dsp",
  "bugs": {
    "url": "https://github.com/eliesgalvira/pragma-dsp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliesgalvira/pragma-dsp.git"
  },
  "author": "Elies Galvira",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "tag": "alpha"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./xform": {
      "import": {
        "types": "./dist/xform/index.d.mts",
        "default": "./dist/xform/index.mjs"
      },
      "require": {
        "types": "./dist/xform/index.d.cts",
        "default": "./dist/xform/index.cjs"
      }
    },
    "./xform/fourier": {
      "import": {
        "types": "./dist/xform/fourier.d.mts",
        "default": "./dist/xform/fourier.mjs"
      },
      "require": {
        "types": "./dist/xform/fourier.d.cts",
        "default": "./dist/xform/fourier.cjs"
      }
    },
    "./xform/stft": {
      "import": {
        "types": "./dist/xform/stft.d.mts",
        "default": "./dist/xform/stft.mjs"
      },
      "require": {
        "types": "./dist/xform/stft.d.cts",
        "default": "./dist/xform/stft.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.mts",
        "default": "./dist/core/index.mjs"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect/index.d.mts",
        "default": "./dist/effect/index.mjs"
      },
      "require": {
        "types": "./dist/effect/index.d.cts",
        "default": "./dist/effect/index.cjs"
      }
    },
    "./math/complex": {
      "import": {
        "types": "./dist/math/index.d.mts",
        "default": "./dist/math/index.mjs"
      },
      "require": {
        "types": "./dist/math/index.d.cts",
        "default": "./dist/math/index.cjs"
      }
    },
    "./fluent": {
      "import": {
        "types": "./dist/fluent/index.d.mts",
        "default": "./dist/fluent/index.mjs"
      },
      "require": {
        "types": "./dist/fluent/index.d.cts",
        "default": "./dist/fluent/index.cjs"
      }
    },
    "./analysis": {
      "import": {
        "types": "./dist/analysis/index.d.mts",
        "default": "./dist/analysis/index.mjs"
      },
      "require": {
        "types": "./dist/analysis/index.d.cts",
        "default": "./dist/analysis/index.cjs"
      }
    },
    "./xform/fourier-fluent": {
      "import": {
        "types": "./dist/xform/fourier-fluent.d.mts",
        "default": "./dist/xform/fourier-fluent.mjs"
      },
      "require": {
        "types": "./dist/xform/fourier-fluent.d.cts",
        "default": "./dist/xform/fourier-fluent.cjs"
      }
    }
  },
  "peerDependencies": {
    "effect": "^4.0.0-beta.64"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "effect-language-service patch",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:reallife": "vitest run test/reallife/",
    "check:pack": "pnpm pack --dry-run",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:tree-shaking": "is-tree-shakable && is-tree-shakable --resolution web",
    "release:check": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run check:pack && pnpm run check:exports && pnpm run check:tree-shaking",
    "release:alpha": "pnpm run release:check && npm publish --tag alpha",
    "release:latest": "pnpm run release:check && npm publish --tag latest",
    "bench": "node --import tsx bench/run.ts",
    "gen:fixtures": "uv run --directory scripts python gen_fixtures.py --overwrite --out ../test/fixtures/pragma-dsp.v0.1.json",
    "gen:refs": "uv run --directory scripts python gen_reallife_refs.py --out ../test/reallife/references/"
  },
  "devDependencies": {
    "@effect/language-service": "0.85.1",
    "@types/node": "25.5.0",
    "effect": "4.0.0-beta.64",
    "is-tree-shakable": "0.5.0",
    "mitata": "^1.0.0",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
