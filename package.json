{
  "name": "pragma-dsp",
  "version": "0.1.0",
  "description": "Useful DSP primitives for TypeScript.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "development": "./src/index.ts",
        "default": "./dist/index.mjs"
      },
      "require": "./dist/index.cjs"
    },
    "./xform": {
      "types": "./dist/xform/index.d.ts",
      "import": {
        "development": "./src/xform/index.ts",
        "default": "./dist/xform/index.mjs"
      },
      "require": "./dist/xform/index.cjs"
    },
    "./xform/fourier": {
      "types": "./dist/xform/fourier.d.ts",
      "import": {
        "development": "./src/xform/fourier.ts",
        "default": "./dist/xform/fourier.mjs"
      },
      "require": "./dist/xform/fourier.cjs"
    },
    "./xform/stft": {
      "types": "./dist/xform/stft.d.ts",
      "import": {
        "development": "./src/xform/stft.ts",
        "default": "./dist/xform/stft.mjs"
      },
      "require": "./dist/xform/stft.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": {
        "development": "./src/core/index.ts",
        "default": "./dist/core/index.mjs"
      },
      "require": "./dist/core/index.cjs"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": {
        "development": "./src/effect/index.ts",
        "default": "./dist/effect/index.mjs"
      },
      "require": "./dist/effect/index.cjs"
    },
    "./math/complex": {
      "types": "./dist/math/index.d.ts",
      "import": {
        "development": "./src/math/index.ts",
        "default": "./dist/math/index.mjs"
      },
      "require": "./dist/math/index.cjs"
    },
    "./fluent": {
      "types": "./dist/fluent/index.d.ts",
      "import": {
        "development": "./src/fluent/index.ts",
        "default": "./dist/fluent/index.mjs"
      },
      "require": "./dist/fluent/index.cjs"
    },
    "./analysis": {
      "types": "./dist/analysis/index.d.ts",
      "import": {
        "development": "./src/analysis/index.ts",
        "default": "./dist/analysis/index.mjs"
      },
      "require": "./dist/analysis/index.cjs"
    },
    "./xform/fourier-fluent": {
      "types": "./dist/xform/fourier-fluent.d.ts",
      "import": {
        "development": "./src/xform/fourier-fluent.ts",
        "default": "./dist/xform/fourier-fluent.mjs"
      },
      "require": "./dist/xform/fourier-fluent.cjs"
    }
  },
  "peerDependencies": {
    "effect": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:reallife": "vitest run test/reallife/",
    "bench": "node --import tsx bench/run.ts",
    "gen:fixtures": "uv run --directory scripts python gen_fixtures.py --overwrite --out ../test/fixtures/pragma-dsp.v0.1.json",
    "gen:refs": "uv run --directory scripts python gen_reallife_refs.py --out ../test/reallife/references/"
  },
  "devDependencies": {
    "effect": "^3.0.0",
    "mitata": "^1.0.0",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
